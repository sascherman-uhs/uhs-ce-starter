# ─────────────────────────────────────────────────────────────────────────────
# CE Classes Admin starter — environment variables
#
# Copy this file to `.env.local` and fill in your own values.
#   cp .env.example .env.local
#
# NEVER commit `.env.local` (it is gitignored). NEVER put secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then run the SQL in
# supabase/migrations/ against it. Find these values in:
#   Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Service role bypasses RLS — keep it secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URLs ─────────────────────────────────────────────────────────────────
# Runtime/in-session app origin (Stripe return URLs, redirects). Localhost is fine in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Public origin baked into DURABLE artifacts (QR codes, flyers, emails). This must
# be your real public URL — NEVER localhost — or generated QR codes/links break.
CE_PUBLIC_APP_URL=https://your-app.example.com

# ── Dev auto-login (optional, development only) ──────────────────────────────
# When set AND NODE_ENV=development, middleware auto-signs-in this user so you can
# work without logging in each time. Create this user in Supabase Auth first.
# Leave BLANK in production (production never auto-logs-in regardless).
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# ── Stripe (optional — STUBBED in this starter) ──────────────────────────────
# Payments are stubbed out (see lib/stripe/client.ts and the README). To enable
# real payments, restore the Stripe client and set these. Get keys from
# https://dashboard.stripe.com/test/apikeys (use sk_test_/whsec_ in test mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (optional — STUBBED in this starter) ───────────────────────────────
# Transactional email (Resend) and SMTP/IMAP draft creation are stubbed. To send
# real email, wire your provider (see the README → "Wiring email").
# Resend (https://resend.com) — verify your sending domain first.
RESEND_API_KEY=
# Gmail SMTP/IMAP (if you restore lib/email/gmail.ts). Use an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
